{
  "name": "Weather App (React)",
  "short_name": "Weather",
  "description": "Lightweight weather app using Open-Meteo — current + 7-day forecast.",
  "start_url": ".",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#071029",
  "theme_color": "#0f172a",
  "icons": [
    { "src": "/icons/icon-72.svg",  "sizes": "72x72",   "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/icons/icon-96.svg",  "sizes": "96x96",   "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/icons/icon-128.svg", "sizes": "128x128", "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/icons/icon-144.svg", "sizes": "144x144", "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/icons/icon-256.svg", "sizes": "256x256", "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/icons/icon-384.svg", "sizes": "384x384", "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/icons/icon-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any maskable" }
  ]
